generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Kid {
  id        String   @id @default(uuid())
  name      String
  emoji     String   @default("🙂")
  token     String   @unique
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id          String   @id @default(uuid())
  kidId       String
  merchant    String
  description String?
  amount      Float // always USD
  originalAmount   Float? // set when paid in a foreign currency
  originalCurrency String?
  category    String
  source      String   @default("manual") // "manual", "applepay", or "return"
  purchasedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // A return is a negative-amount purchase linked to the original.
  refundsId  String?
  refunds    Purchase?  @relation("PurchaseRefund", fields: [refundsId], references: [id], onDelete: SetNull)
  refundedBy Purchase[] @relation("PurchaseRefund")

  kid Kid @relation(fields: [kidId], references: [id], onDelete: Cascade)

  @@index([kidId])
  @@index([category])
  @@index([purchasedAt])
}
